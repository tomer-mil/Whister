{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".tsc-out"
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".tsc-out"
  ]
}
